# Azure OpenAI (Foundry)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Banco de dados (docker-compose) — credenciais do serviço `db`
POSTGRES_USER=ead
POSTGRES_PASSWORD=ead
POSTGRES_DB=ead
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ead:ead@localhost:5432/ead

# Porta do backend no host (default 8000)
BACKEND_PORT=8000

# Orquestração (legado)
TRIAGEM_LIMIAR_CONFIANCA=0.8
TRIAGEM_OFFLINE=0

# Mock APIs (legado)
MOCK_API_URL=http://127.0.0.1:8000
MOCK_API_TIMEOUT=10
