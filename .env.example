# Azure OpenAI (Foundry)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Envio de documentos (Resend) — issue #6
# Sem RESEND_API_KEY o envio é SIMULADO (PDF gerado + log; nada sai por e-mail).
# onboarding@resend.dev é o remetente de teste do Resend.
RESEND_API_KEY=
RESEND_FROM=Assistente Acadêmico EAD <onboarding@resend.dev>
RESEND_TIMEOUT_SEGUNDOS=10

# Sessões do chat (issue #11) — fechamento automático por inatividade
# Minutos sem interação antes do job fechar a conversa com motivo TIMEOUT.
THREAD_TIMEOUT_MIN=10
# Intervalo entre varreduras do job (segundos) e chave para desligá-lo.
THREAD_TIMEOUT_CHECK_SEGUNDOS=60
THREAD_TIMEOUT_JOB_ATIVO=1

# Banco de dados (docker-compose) — credenciais do serviço `db`
POSTGRES_USER=ead
POSTGRES_PASSWORD=ead
POSTGRES_DB=ead
POSTGRES_PORT=5432
# Comentado por padrão: sem Docker, o backend usa SQLite local
# (sqlite:///./ead.db). Descomente para apontar a um Postgres já existente.
# DATABASE_URL=postgresql+psycopg://ead:ead@localhost:5432/ead

# Ambiente da aplicação (bloqueia o seed demo em 'production')
APP_ENV=development

# Porta do backend no host (default 8000)
BACKEND_PORT=8000

# Orquestração (legado)
TRIAGEM_LIMIAR_CONFIANCA=0.8
TRIAGEM_OFFLINE=0

# Mock APIs (legado)
MOCK_API_URL=http://127.0.0.1:8000
MOCK_API_TIMEOUT=10
